# ==============================================================
# Spell Chess Online - Server Environment Variables
# Copy this file to .env and fill in your values
# ==============================================================

# Port the server listens on
PORT=5000

# Secret key used to sign JWT tokens - CHANGE THIS to a long random string!
# Generate one at: https://generate-secret.vercel.app/64
JWT_SECRET=your-super-secret-jwt-key-change-this

# Path to the SQLite database file
DB_PATH=./spellchess.db

# Allowed frontend origin for CORS (change to your deployed frontend URL when hosting)
CLIENT_ORIGIN=http://localhost:5173
