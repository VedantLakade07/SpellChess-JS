# ==============================================================
# Spell Chess Online - Client Environment Variables
# Copy this file to .env and fill in your values
# NOTE: All Vite env vars MUST start with VITE_ to be exposed to the browser
# ==============================================================

# Full URL to the backend auth API (change to your deployed backend URL when hosting)
VITE_API_URL=http://localhost:5000/api/auth

# Full URL to the backend Socket.io server (change to your deployed backend URL when hosting)
VITE_SOCKET_URL=http://localhost:5000
